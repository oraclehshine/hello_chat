# 在线部署时，这里写 Docker Hub 镜像名
# 离线部署时，这里写服务器 docker load 导入后的镜像名
BACKEND_IMAGE=your-dockerhub-name/hello-chat-backend:latest
FRONT_IMAGE=your-dockerhub-name/hello-chat-front:latest
BACKEND_BIND=127.0.0.1:8083:8083
FRONT_BIND_PORT=3000
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.7.0
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.0

DB_USERNAME=postgres
DB_PASSWORD=change-me
REDIS_PASSWORD=
HELLO_CHAT_AUTH_SECRET=change-me-to-a-long-random-secret
HELLO_CHAT_ACCESS_TOKEN_SECONDS=7200
HELLO_CHAT_ADMIN_USER_IDS=1

ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=hello-chat-im
ALIYUN_OSS_PUBLIC_URL_PREFIX=https://hello-chat-im.oss-cn-hangzhou.aliyuncs.com/
